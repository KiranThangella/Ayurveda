# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini (server-only — never prefix with NEXT_PUBLIC_, used only inside app/api/generate/*)
GEMINI_API_KEY=
# Optional override, defaults to gemini-3.6-flash
# GEMINI_MODEL=gemini-3.6-flash

# Optional fallback providers (lib/ai/providers.ts) — tried in order only if
# Gemini's key is missing or every Gemini attempt fails. Leave unset to skip;
# add any subset. Model defaults are current as of Aug 2026 — override via the
# matching *_MODEL var if a provider retires its model (this whole fallback
# system exists because that happened to gemini-2.0-flash).
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6
# NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.1-70b-instruct
# Cloudflare Workers AI via REST (not a binding — this is the Vercel-reachable
# version). Free tier: 10,000 "neurons"/day. Get CF_API_TOKEN from
# dash.cloudflare.com > My Profile > API Tokens (needs "Workers AI" read access).
# CF_ACCOUNT_ID=
# CF_API_TOKEN=
# CF_WORKERS_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
# Local Ollama — ONLY reachable while running `npm run dev` on the same machine
# Ollama is running on. Never set this in a real Vercel deployment; it can't
# reach your localhost. No API key needed.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Supabase service role — server-only, used by the auto-generation cron to write
# ebooks/chapters/jobs bypassing RLS. Get this from Supabase dashboard > Settings > API.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for manually calling this route's x-cron-secret header (local
# dev / debugging only — the actual daily cron is the Cloudflare Worker at
# workers/ebook-cron/, which uses its own MANUAL_TRIGGER_SECRET, set separately
# via `wrangler secret put` there). Generate any long random string.
CRON_SECRET=

# Free stock images for chapter/cover photos — get a free key at pexels.com/api
PEXELS_API_KEY=

# Gates /admin and app/api/admin/review/* — the only account allowed in is whichever
# Supabase user signs in with this exact email (see lib/auth-server.ts). Server-only,
# never prefixed with NEXT_PUBLIC_, so it is never shipped to the browser.
ADMIN_EMAIL=ayurvedalibrary7@gmail.com
